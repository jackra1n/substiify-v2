# Bot configuration
BOT_TOKEN=""
BOT_PREFIX=""

# Database configuration
DB_HOST="postgres"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="substiify"

# Optional, only for the first upgrade from naive timestamp columns.
# Database timezone is detected from the old PostgreSQL session by default.
# Override it if that timezone was changed before upgrading.
LEGACY_DATABASE_TIMEZONE=""
# Defaults to the legacy database timezone. Set the bot's old OS timezone here
# if it differed (used by historical Steam discovery timestamps).
LEGACY_APPLICATION_TIMEZONE=""

# Lavalink configuration
LAVALINK_NODE_URL="http://localhost:2333/"
LAVALINK_PASSWORD="youshallnotpass"

# This is used for the backup script at resources/db_backup.sh
BACKUP_DIR=""